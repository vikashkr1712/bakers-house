# Server-only Razorpay TEST credentials. Live keys are rejected.
# Copy to .env.local; never prefix secret names with VITE_.
# Required for online test payments only. Cash orders work without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional signed Razorpay payment webhook, separate from normal polling.
RAZORPAY_WEBHOOK_SECRET=

# Optional bakery WhatsApp recipient override, including country code.
# Default is the public bakery contact: 917982107035.
BAKERY_WHATSAPP_NUMBER=

# Optional server-only storage override. The default is ignored local storage.
ORDER_DATABASE_PATH=.payment-data/orders.sqlite
# Standalone npm start settings; local-only by default.
HOST=127.0.0.1
PORT=5000
# Optional comma-separated allowed hostnames for order API requests.
ORDER_ALLOWED_HOSTS=

# This checkout uses customer-sent wa.me messages after saved COD or verified
# online test payment. No Meta/WhatsApp Cloud API credentials are required.
